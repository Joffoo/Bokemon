#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Bokemon pre-commit hook — 拦截体积过大的源码文件
#
# 规则：单个源码文件超过 20 KB（20480 字节）就中断提交，并提示按功能拆分。
# 目的：文件一大，人和模型都读不完，改起来只能看到局部，容易改错。
#
# 跳过（不可能是"需要人读的源码"）：
#   · lockfile         package-lock.json / pnpm-lock.yaml / Cargo.lock / go.sum …
#   · 压缩产物         *.min.js / *.min.css / *.map / *.bundle.js
#   · 构建 & 三方目录  dist/ build/ node_modules/ vendor/ site-packages/ …
#   · 自动生成文件     文件头含 @generated / code generated by / do not edit …
#   · 二进制资源      重命名为 .png · .svg 之类，或本就不在源码后缀表里
#
# 安装（只需一次）：git config core.hooksPath .githooks
# 临时绕过：        git commit --no-verify
# ---------------------------------------------------------------------------
set -u

THRESHOLD_BYTES=20480                     # 20 KiB
BASELINE_FILE=".githooks/size-baseline.txt"
THRESHOLD_LABEL="20 KB"

# 算作"源码"的后缀（小写）
CODE_EXT='py|pyi|js|jsx|mjs|cjs|ts|tsx|vue|svelte|html|htm|css|scss|sass|less|go|rs|java|kt|kts|scala|cs|fs|vb|c|h|cc|cpp|cxx|hpp|hh|m|mm|swift|rb|php|pl|pm|lua|sh|bash|zsh|fish|ps1|psm1|bat|cmd|sql|r|jl|dart|zig|nim|ex|exs|erl|clj|cljs|hs|ml|tex|proto|graphql|gql'

# 构建产物 / 三方代码目录
SKIP_PATH_RE='(^|/)(node_modules|dist|build|out|vendor|third_party|third-party|__generated__|generated|gen|site-packages|\.venv|venv|\.next|coverage|__snapshots__)/'

# 文件头里出现这些字样 → 视为机器生成
GEN_MARK_RE='@generated|auto[- ]?generated|automatically generated|code generated by|do not edit|this file is generated|generated file'

# 文件名级跳过
is_skipped_name() {
  case "$1" in
    # lockfile
    package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|bun.lock|bun.lockb) return 0 ;;
    Cargo.lock|poetry.lock|Pipfile.lock|composer.lock|Gemfile.lock|mix.lock|pubspec.lock) return 0 ;;
    flake.lock|uv.lock|pdm.lock|Podfile.lock|packages.lock.json|*.lock) return 0 ;;
    # 压缩 / 打包 / 快照
    *.min.js|*.min.mjs|*.min.css|*.map|*.bundle.js|*.chunk.js|*.snap) return 0 ;;
    # 代码生成产物（按命名约定）
    *.pb.go|*_pb2.py|*_pb2_grpc.py|*.g.dart|*.designer.cs|*.generated.*|*.auto.*|*.d.ts) return 0 ;;
    # 静态资源：图片、字体、媒体、压缩包
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.bmp|*.svg) return 0 ;;
    *.woff|*.woff2|*.ttf|*.otf|*.eot|*.pdf|*.zip|*.gz|*.tar|*.7z) return 0 ;;
  esac
  return 1
}

fmt_kb() { awk -v b="$1" 'BEGIN { printf "%.1f KB", b / 1024 }'; }

# 从基线文件取记录的字节数；命中则 0 退出，否则 1
baseline_size() {
  [ -f "$BASELINE_FILE" ] || return 1
  awk -v p="$1" '
    /^[[:space:]]*#/ { next }
    NF >= 1 && $1 == p { print ($2 == "" ? 0 : $2); found = 1; exit }
    END { if (!found) exit 1 }
  ' "$BASELINE_FILE"
}

cd "$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1

# ---------------------------------------------------------------------------
# SSOT 提示词一致性检查：js/ 模块的提示词副本一致 + 指纹与登记值相符。
# 纯生成型子 Agent 的教训：提示词改一处漏一处，靠人眼盯不住，机器必须拦。
# 有意修改提示词后：python bench/ab-divergence/prompts.py --update-fingerprint
# ---------------------------------------------------------------------------
if command -v python >/dev/null 2>&1 \
   && [ -f "bench/ab-divergence/prompts.py" ] && [ -f "bench/ab-divergence/PROMPTS_FINGERPRINT" ]; then
  if ! python bench/ab-divergence/prompts.py --check; then
    echo
    echo "提示词 SSOT 校验未通过（见上）。确属有意修改：python bench/ab-divergence/prompts.py --update-fingerprint"
    exit 1
  fi
fi

violations=()
n_violations=0
while IFS= read -r -d '' st && IFS= read -r -d '' path; do
  base="${path##*/}"

  is_skipped_name "$base" && continue
  [[ "$path" =~ $SKIP_PATH_RE ]] && continue

  # 只检查有源码后缀的文件（无后缀的脚本、图片一律放过）
  [[ "$base" == *.* ]] || continue
  ext="$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')"
  [[ "$ext" =~ ^($CODE_EXT)$ ]] || continue

  size="$(git cat-file -s ":$path" 2>/dev/null)" || continue
  [ "$size" -le "$THRESHOLD_BYTES" ] && continue

  case "$st" in
    A*|C*) note="新增" ;;
    R*)    note="重命名" ;;
    *)     note="改动后超限" ;;
  esac
  if base_limit="$(baseline_size "$path")"; then
    # 已登记的超大文件：不继续变大就放行（棘轮，防止越滚越大）
    [ "$size" -le "$base_limit" ] && continue
    note="已超基线 $(fmt_kb "$base_limit")"
  fi

  # 自动生成的文件放过
  if git cat-file -p ":$path" 2>/dev/null | head -n 5 | grep -Eqi "$GEN_MARK_RE"; then
    continue
  fi

  violations+=("$size|$path|$note")
  n_violations=$((n_violations + 1))
done < <(git diff --cached --name-status -z --no-renames --diff-filter=AM)

[ "$n_violations" -eq 0 ] && exit 0

printf '\n'
printf '✗ 提交被拦截：以下源码文件超过 %s\n\n' "$THRESHOLD_LABEL"
for v in "${violations[@]}"; do
  IFS='|' read -r size path note <<< "$v"
  printf '    %-10s %s   (%s)\n' "$(fmt_kb "$size")" "$path" "$note"
done
cat <<'EOF'

文件太大，人和模型都很难一次读完，改动时容易只看到局部、改错地方。
请按功能拆分后再提交：

  · 按功能拆：一个文件只负责一件事（状态 / 渲染 / 导出 / 请求 …）
      例：index.html 里的卡片渲染 → src/render/card.js
  · 按模块拆：独立功能各自成文件，用 <script type="module"> 或 import 串起来
  · 数据外移：长配置、示例数据、提示词模板挪到 data/*.json 或独立文件
  · 资源用引用：不要把 base64 图片、内联字体塞进源码（改用 .png / .woff2）
  · 拆完保持行为不变，逐块验证 —— 拆分不是重写

已跳过：lockfile、*.min.*、构建产物、文件头标了 @generated 的生成文件、图片字体。
已登记的老大文件见 .githooks/size-baseline.txt：只要不再变大就放行，拆分完成后请删掉对应行。

确有必要（例如整包引入第三方代码）：git commit --no-verify
EOF
printf '\n'
exit 1
